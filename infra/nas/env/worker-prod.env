# Non-secret settings for the PROD feed worker. DATABASE_URL is assembled on the NAS by deploy-worker.sh.
COMPOSE_PROJECT_NAME=pretzuri-prod-worker
PRETZURI_ENV=prod
SUPABASE_NETWORK=pretzuri-prod_default
# TEMPORARY (founder decision 2026-11-25): PROD starts with the DEV sample catalog (fictitious demo shops fed from the
# bundled fixtures) until real 2Performant/Profitshare feeds are connected. Set to 0 and delete the demo merchants then.
WORKER_ALLOW_FIXTURES=1
LOG_LEVEL=info
WORKER_POLL_SECONDS=30
