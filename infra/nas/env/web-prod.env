# Non-secret settings for the PROD web container.
COMPOSE_PROJECT_NAME=pretzuri-prod-web
PRETZURI_ENV=prod
WEB_BIND_IP=127.0.0.1
WEB_HTTP_PORT=3500
NEXT_PUBLIC_SUPABASE_URL=https://api-pretzuri.it-ist.ro
NEXT_PUBLIC_SITE_URL=https://pretzuri.it-ist.ro
NEXT_PUBLIC_NOINDEX=true
SUPABASE_NETWORK=pretzuri-prod_default
