# Non-secret settings for the PROD Supabase stack on the NAS (not deployed yet; only on explicit request).
COMPOSE_PROJECT_NAME=pretzuri-prod
COMPOSE_FILE=docker-compose.yml:docker-compose.pretzuri.yml:docker-compose.prod.yml

API_GW_BIND_IP=127.0.0.1
API_GW_HTTP_PORT=8500
DB_BIND_IP=127.0.0.1
POOLER_SESSION_HOST_PORT=54352
POOLER_PROXY_PORT_TRANSACTION=54353
POOLER_TENANT_ID=pretzuri-prod

SUPABASE_PUBLIC_URL=https://api-pretzuri.it-ist.ro
API_EXTERNAL_URL=https://api-pretzuri.it-ist.ro
SITE_URL=https://pretzuri.it-ist.ro
ADDITIONAL_REDIRECT_URLS=https://pretzuri.it-ist.ro/**

STUDIO_DEFAULT_ORGANIZATION=Pretzuri
STUDIO_DEFAULT_PROJECT=Pretzuri-PROD
FUNCTIONS_MEMORY_LIMIT=256m
GATEWAY_DENY_DASHBOARD=true

# SMTP: real provider; credentials only in the NAS .env (infra/nas/set-smtp-secret.sh prod).
SMTP_HOST=
SMTP_PORT=587
SMTP_ADMIN_EMAIL=noreply@it-ist.ro
SMTP_SENDER_NAME=Pretzuri
MAILER_SUBJECT_OTP=Pretzuri: codul tău / your code
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_OTP_LENGTH=6
MAILER_OTP_EXP=900

AUTH_RATE_LIMIT_HEADER=CF-Connecting-IP
AUTH_RATE_LIMIT_EMAIL_SENT=30
AUTH_RATE_LIMIT_OTP=10
AUTH_RATE_LIMIT_VERIFY=30
AUTH_RATE_LIMIT_TOKEN_REFRESH=150
AUTH_SESSIONS_TIMEBOX=720h
AUTH_SESSIONS_INACTIVITY_TIMEOUT=336h

MFA_TOTP_ENROLL_ENABLED=true
MFA_TOTP_VERIFY_ENABLED=true

COMPOSE_PROFILES=
ENABLE_IMAGE_TRANSFORMATION=false

VAPID_SUBJECT=mailto:noreply@it-ist.ro
