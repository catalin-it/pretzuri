# Non-secret settings for the DEV web container. The anon key is read on the NAS at build time.
COMPOSE_PROJECT_NAME=pretzuri-dev-web
PRETZURI_ENV=dev
WEB_BIND_IP=127.0.0.1
WEB_HTTP_PORT=3400
NEXT_PUBLIC_SUPABASE_URL=https://api-dev-pretzuri.it-ist.ro
NEXT_PUBLIC_SITE_URL=https://dev-pretzuri.it-ist.ro
# DEV must not be indexed.
NEXT_PUBLIC_NOINDEX=true
