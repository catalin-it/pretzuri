# Non-secret settings for the DEV feed worker. DATABASE_URL is assembled on the NAS by deploy-worker.sh.
COMPOSE_PROJECT_NAME=pretzuri-dev-worker
PRETZURI_ENV=dev
SUPABASE_NETWORK=pretzuri-dev_default
# DEV only: allows fixture:<name> / https://fixtures.invalid/<name> feed URLs (sample feeds bundled in the image).
WORKER_ALLOW_FIXTURES=1
LOG_LEVEL=info
WORKER_POLL_SECONDS=15
