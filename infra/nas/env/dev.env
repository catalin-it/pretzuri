# Non-secret settings for the DEV Supabase stack on the NAS.
# Applied on top of .env by remote-apply.sh. Secrets are generated on the NAS and never stored here.
COMPOSE_PROJECT_NAME=pretzuri-dev
COMPOSE_FILE=docker-compose.yml:docker-compose.pretzuri.yml:docker-compose.dev-mail.yml

# Ports: localhost only (DSM reverse proxy + ssh scripts). Checked free on 2026-11-24 (8310 is another app).
API_GW_BIND_IP=127.0.0.1
API_GW_HTTP_PORT=8400
DB_BIND_IP=127.0.0.1
POOLER_SESSION_HOST_PORT=54342
POOLER_PROXY_PORT_TRANSACTION=54343
POOLER_TENANT_ID=pretzuri-dev

# URLs: public via Cloudflare (proxied) + DSM reverse proxy.
SUPABASE_PUBLIC_URL=https://api-dev-pretzuri.it-ist.ro
API_EXTERNAL_URL=https://api-dev-pretzuri.it-ist.ro
SITE_URL=https://dev-pretzuri.it-ist.ro
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,https://dev-pretzuri.it-ist.ro/**

STUDIO_DEFAULT_ORGANIZATION=Pretzuri
STUDIO_DEFAULT_PROJECT=Pretzuri-DEV
FUNCTIONS_MEMORY_LIMIT=256m

# Mailpit (DEV mail catcher, LAN only: http://192.168.0.111:8425, basic auth user "pretzuri").
MAILPIT_BIND_IP=0.0.0.0
MAILPIT_UI_PORT=8425

# Auth: email code (6 digits, 15 min) + optional password. Mail goes to Mailpit on DEV.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@it-ist.ro
SMTP_SENDER_NAME=Pretzuri
MAILER_SUBJECT_OTP=Pretzuri: codul tău / your code
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_OTP_LENGTH=6
MAILER_OTP_EXP=900

# Auth hardening. All public hosts are Cloudflare-proxied and DSM accepts only Cloudflare IPs for them.
AUTH_RATE_LIMIT_HEADER=CF-Connecting-IP
AUTH_RATE_LIMIT_EMAIL_SENT=200
AUTH_RATE_LIMIT_OTP=10
AUTH_RATE_LIMIT_VERIFY=30
AUTH_RATE_LIMIT_TOKEN_REFRESH=150
AUTH_SESSIONS_TIMEBOX=720h
AUTH_SESSIONS_INACTIVITY_TIMEOUT=336h

# Admin step-up (TOTP). Users never need it.
MFA_TOTP_ENROLL_ENABLED=true
MFA_TOTP_VERIFY_ENABLED=true

# Optional services, off by default (RAM). Comma list of: studio, pooler, imgproxy, realtime.
COMPOSE_PROFILES=
ENABLE_IMAGE_TRANSFORMATION=false

# Web Push VAPID "sub" claim.
VAPID_SUBJECT=mailto:noreply@it-ist.ro
